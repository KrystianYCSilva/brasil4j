<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.brasil4j</groupId>
        <artifactId>brasil4j</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>
    <artifactId>brasil4j-core</artifactId>
    <name>brasil4j-core</name>
    <description>Objetos de valor e validação de documentos e códigos brasileiros em Java.</description>
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- TQ-9 / AR-*: architecture rules as tests; test scope only (IV.2). -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- JA-14: stable JPMS name; never change it. -->
                            <Automatic-Module-Name>io.github.brasil4j.core</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <configuration>
                    <source>8</source>
                    <doclint>all</doclint>
                    <failOnWarnings>true</failOnWarnings>
                    <detectJavaApiLink>false</detectJavaApiLink>
                </configuration>
                <executions>
                    <execution>
                        <id>api-documentation</id>
                        <phase>${brasil4j.javadoc.phase}</phase>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- TQ-10 / IV.5: mutation testing of the Java core. Run on JDK 21:
             ./mvnw -pl brasil4j-core -Pmutation test-compile org.pitest:pitest-maven:mutationCoverage -->
        <profile>
            <id>mutation</id>
            <properties>
                <pitest.mutationThreshold>89</pitest.mutationThreshold>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${pitest.version}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${pitest.junit5.version}</version>
                            </dependency>
                        </dependencies>
                        <configuration>
                            <targetClasses>
                                <param>io.github.brasil4j.*</param>
                            </targetClasses>
                            <targetTests>
                                <param>io.github.brasil4j.*</param>
                            </targetTests>
                            <excludedTestClasses>
                                <param>*EquivalenceTest</param>
                                <param>*JarIT</param>
                                <param>io.github.brasil4j.ArchitectureTest</param>
                            </excludedTestClasses>
                            <mutationThreshold>${pitest.mutationThreshold}</mutationThreshold>
                            <timestampedReports>false</timestampedReports>
                            <outputFormats>
                                <param>HTML</param>
                                <param>XML</param>
                            </outputFormats>
                            <threads>4</threads>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
